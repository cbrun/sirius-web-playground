    <lines xmi:type="table:DLine" uid="_hPutDUUZEe-Em7KKoPPppQ" label="EClass : PoissonDistribution">
      <target xmi:type="ecore:EClass" href="guesstimate.ecore#//PoissonDistribution"/>
      <lines xmi:type="table:DLine" uid="_hPxJREUZEe-Em7KKoPPppQ" label="EAttribute : mean">
        <target xmi:type="ecore:EAttribute" href="guesstimate.ecore#//PoissonDistribution/mean"/>
        <semanticElements xmi:type="ecore:EAttribute" href="guesstimate.ecore#//PoissonDistribution/mean"/>
        <originMapping xmi:type="description_2:LineMapping" href="platform:/plugin/org.eclipse.emf.ecoretools.design/description/ecore.odesign#//@ownedViewpoints[name='Review']/@ownedRepresentations[name='Documentation']/@ownedLineMappings[name='Doc%20EClassifiers']/@ownedSubLines[name='Doc%20EStructural%20Features']"/>
      </lines>
      <semanticElements xmi:type="ecore:EClass" href="guesstimate.ecore#//PoissonDistribution"/>
      <originMapping xmi:type="description_2:LineMapping" href="platform:/plugin/org.eclipse.emf.ecoretools.design/description/ecore.odesign#//@ownedViewpoints[name='Review']/@ownedRepresentations[name='Documentation']/@ownedLineMappings[name='Doc%20EClassifiers']"/>
      <cells xmi:type="table:DCell" uid="_hQCPAUUZEe-Em7KKoPPppQ" label="The Poisson distribution is a discrete probability distribution that expresses the probability of a given number of events occurring in a fixed interval of time or space. Defined by the rate parameter (λ), it is suitable for modeling count data, such as the number of emails received per hour or the number of accidents at a traffic intersection in a day." column="_hP1asEUZEe-Em7KKoPPppQ">
        <target xmi:type="ecore:EStringToStringMapEntry" href="guesstimate.ecore#//PoissonDistribution/%http:%2F%2Fwww.eclipse.org%2Femf%2F2002%2FGenModel%/@details.0"/>
        <semanticElements xmi:type="ecore:EStringToStringMapEntry" href="guesstimate.ecore#//PoissonDistribution/%http:%2F%2Fwww.eclipse.org%2Femf%2F2002%2FGenModel%/@details.0"/>
        <currentStyle xmi:type="table:DCellStyle" uid="_hQCPAkUZEe-Em7KKoPPppQ" defaultBackgroundStyle="true" backgroundColor="220,234,183">
          <backgroundStyleOrigin xmi:type="description_2:IntersectionMapping" href="platform:/plugin/org.eclipse.emf.ecoretools.design/description/ecore.odesign#//@ownedViewpoints[name='Review']/@ownedRepresentations[name='Documentation']/@intersection.0"/>
        </currentStyle>
        <intersectionMapping xmi:type="description_2:IntersectionMapping" href="platform:/plugin/org.eclipse.emf.ecoretools.design/description/ecore.odesign#//@ownedViewpoints[name='Review']/@ownedRepresentations[name='Documentation']/@intersection.0"/>
      </cells>
    </lines>
    <lines xmi:type="table:DLine" uid="_hPutD0UZEe-Em7KKoPPppQ" label="EClass : ExponentialDistribution">
      <target xmi:type="ecore:EClass" href="guesstimate.ecore#//ExponentialDistribution"/>
