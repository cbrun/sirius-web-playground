<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>fr.obeo.dsl.guesstimate</groupId>
		<artifactId>fr.obeo.dsl.guesstimate.releng</artifactId>
		<version>0.0.7-SNAPSHOT</version>
		<relativePath>../fr.obeo.dsl.guesstimate.releng/pom.xml</relativePath>
	</parent>
	<artifactId>fr.obeo.dsl.guesstimate.views</artifactId>

	<dependencies>
		<dependency>
			<groupId>fr.obeo.dsl.guesstimate</groupId>
			<artifactId>fr.obeo.dsl.guesstimate</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>org.eclipse.emf</groupId>
			<artifactId>org.eclipse.emf.common</artifactId>
			<version>2.45.0</version>
		</dependency>
		<dependency>
			<groupId>org.eclipse.emf</groupId>
			<artifactId>org.eclipse.emf.ecore</artifactId>
			<version>2.42.0</version>
		</dependency>
		<dependency>
			<groupId>org.eclipse.sirius</groupId>
			<artifactId>org.eclipse.sirius.emfjson</artifactId>
			<version>2.5.4-SNAPSHOT</version>
		</dependency>
		<dependency>
			<groupId>org.eclipse.sirius</groupId>
			<artifactId>sirius-components-emf</artifactId>
